{
  "name": "Retail Control Room",
  "dataColors": [
    "#FFD447",
    "#33C7D4",
    "#FF6F61",
    "#7EE081",
    "#A78BFA"
  ],
  "background": "#061B2C",
  "foreground": "#F5FAFF",
  "tableAccent": "#FFD447",
  "good": "#33C7D4",
  "neutral": "#9CB5C8",
  "bad": "#FF6F61",
  "maximum": "#C5654D",
  "center": "#D8CBB8",
  "minimum": "#F3EFE6",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 15,
      "color": "#F5FAFF"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#F5FAFF"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#9CB5C8"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#FFD447"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFDF8"
              }
            },
            "transparency": 4
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D8CBB8"
              }
            },
            "radius": 3
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 14,
            "right": 14
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit"
          }
        ]
      }
    }
  }
}