table RetailData
	lineageTag: d9c1f7d5-ce73-4107-8898-b6ba5fadfeef

	/// Retail sales in the current filter context, USD millions
	measure 'Total Sales' = CALCULATE(SUM(RetailData[Sales]), KEEPFILTERS(RetailData[Category] <> "Total Market"))
		formatString: #,0
		lineageTag: a42c105f-8aa0-437d-aaee-00ddf02ffe75

	/// Comparable prior-year retail sales in the current filter context
	measure 'Prior Year Sales' = CALCULATE(SUM(RetailData[Prior Year Amount]), KEEPFILTERS(RetailData[Category] <> "Total Market"))
		formatString: #,0
		lineageTag: bc3df59f-598c-4bea-90cb-f434b4d9dbc5

	/// Current sales minus comparable prior-year sales
	measure 'YoY Change' = CALCULATE(SUM(RetailData[YoY Delta]), KEEPFILTERS(RetailData[Category] <> "Total Market"))
		formatString: #,0
		lineageTag: 1602651b-d870-44e8-842f-e6940bb981b5

	/// Retail sales amount represented by the current filter context
	measure 'Sales Total' = CALCULATE(SUM(RetailData[Sales Amount]), KEEPFILTERS(RetailData[Category] <> "Total Market"))
		formatString: #,0
		lineageTag: 73fb7224-b8ef-4341-ae52-7b752bdc2576

	/// Number of categories in the current filter context
	measure 'Category Count' = DISTINCTCOUNT(RetailData[Category Code])
		formatString: 0
		lineageTag: f51a2871-3837-47c3-b9a2-b3cde89f2eec

	/// Latest year in the current filter context
	measure 'Latest Year' = MAX(RetailData[Year])
		formatString: 0
		lineageTag: cd7693de-329b-4a82-ad0b-45386642d8cb

	/// Year-over-year change divided by the comparable prior-year base
	measure 'YoY Growth' = DIVIDE([YoY Change], [Prior Year Sales])
		formatString: 0.0%
		lineageTag: fd840610-5891-4c95-9bb9-c65d81c643bf

	/// Gap between the latest selected complete-year sales and the peak complete year since 2020
	measure 'Distance to Complete-Year Peak' =
		VAR CurrentYear = MIN(2025, MAX(RetailData[Year]))
		VAR CurrentSales = CALCULATE([Total Sales], REMOVEFILTERS(RetailData[Year]), RetailData[Year] = CurrentYear)
		VAR PeakSales = MAXX(FILTER(ALL(RetailData[Year]), RetailData[Year] >= 2020 && RetailData[Year] <= 2025), CALCULATE([Total Sales]))
		RETURN DIVIDE(CurrentSales - PeakSales, PeakSales)
		formatString: +0.0%;-0.0%;0.0%

	/// Category share of the selected retail sales total
	measure 'Share of Selected Sales' = DIVIDE([Sales Total], CALCULATE([Sales Total], ALLSELECTED(RetailData[Category])))
		formatString: 0.0%
		lineageTag: 5bf32d39-466a-4902-96d4-ca9432222b98

	/// Sales for 2025, the latest complete calendar year in the extract
	measure 'Latest Complete Sales' = CALCULATE(SUM(RetailData[Sales]), RetailData[Year] = 2025, KEEPFILTERS(RetailData[Category] <> "Total Market"))
		formatString: #,0
		lineageTag: 47fdc9d3-c5e1-4236-94fd-40f96b4be86d

	/// Comparable 2024 sales carried on the 2025 rows
	measure 'Latest Complete Prior Sales' = CALCULATE(SUM(RetailData[Prior Year Amount]), RetailData[Year] = 2025, KEEPFILTERS(RetailData[Category] <> "Total Market"))
		formatString: #,0
		lineageTag: b25d763a-17ff-4c53-a794-27ce3ee833bd

	/// 2025 sales minus comparable 2024 sales
	measure 'Latest Complete Change' = CALCULATE(SUM(RetailData[YoY Delta]), RetailData[Year] = 2025, KEEPFILTERS(RetailData[Category] <> "Total Market"))
		formatString: #,0
		lineageTag: 6c05c155-e4fd-4de4-85e6-8160655a0351

	/// Percentage change between complete calendar years 2025 and 2024
	measure 'Latest Complete YoY Growth' = DIVIDE([Latest Complete Change], [Latest Complete Prior Sales])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 42c1cfb8-2d2c-439f-a85b-19d5bfeac679

	/// Latest complete-year category sales converted from USD millions to USD billions
	measure 'Latest Complete Sales B Display' = IF(SELECTEDVALUE(RetailData[Category]) = "Total Market", BLANK(), DIVIDE([Latest Complete Sales], 1000))
		formatString: $#,0.0
		lineageTag: 62870580-36ce-48db-96fd-48739fc18bd9

	/// Latest complete-year sales in USD billions, including the filtered total card context
	measure 'Latest Complete Sales B' = DIVIDE(CALCULATE([Latest Complete Sales], KEEPFILTERS(RetailData[Category] <> "Total Market")), 1000)
		formatString: $#,0.0
		lineageTag: 7a5673f9-e985-4796-8708-e7a60119c89c

	/// Prior complete-year sales in USD billions, excluding the aggregate Total Market row
	measure 'Latest Complete Prior Sales B' = DIVIDE(CALCULATE([Latest Complete Prior Sales], KEEPFILTERS(RetailData[Category] <> "Total Market")), 1000)
		formatString: $#,0.0
		lineageTag: c9ee2706-0fcc-47ae-9572-b709a49008bc

	/// Complete-year net movement in USD billions, excluding the aggregate Total Market row
	measure 'Latest Complete Change B' = DIVIDE(CALCULATE([Latest Complete Change], KEEPFILTERS(RetailData[Category] <> "Total Market")), 1000)
		formatString: $+#,0.0;$-#,0.0;$0.0
		lineageTag: aca23f8a-dc16-4f7e-bc32-29ebe4bcbf9a

	/// Category contribution in USD billions; aggregate Total Market is intentionally blank
	measure 'Latest Complete Change B Display' = IF(SELECTEDVALUE(RetailData[Category]) = "Total Market", BLANK(), DIVIDE([Latest Complete Change], 1000))
		formatString: $+#,0.0;$-#,0.0;$0.0
		lineageTag: f838aa34-fa50-481a-8489-25270cedce6c

	/// Current sales converted to USD billions with aggregate Total Market excluded from category visuals
	measure 'Sales Total B Display' = IF(SELECTEDVALUE(RetailData[Category]) = "Total Market", BLANK(), DIVIDE([Sales Total], 1000))
		formatString: $#,0.0
		lineageTag: db00f9fe-cb54-4f92-ad0e-0685e42b9349

	/// Prior-year category base expressed in USD billions
	measure 'Prior Year Sales B' = DIVIDE([Prior Year Sales], 1000)
		formatString: $#,0.0

	/// Year-over-year movement converted to USD billions with aggregate Total Market excluded
	measure 'YoY Change B Display' = IF(SELECTEDVALUE(RetailData[Category]) = "Total Market", BLANK(), DIVIDE([YoY Change], 1000))
		formatString: $+#,0.0;$-#,0.0;$0.0
		lineageTag: c747eeda-deae-437f-b6b0-9d9ab96513bc

	column Category
		dataType: string
		lineageTag: c494c48a-d672-4aeb-87c2-a73a53c2aa40
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column 'Category Code'
		dataType: string
		lineageTag: 373dd0ed-f2af-43d1-bf7c-57e1d3aa2b9a
		summarizeBy: none
		sourceColumn: Category Code

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 982c7124-16cf-427a-94c4-db887e018924
		summarizeBy: sum
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column Sales
		dataType: int64
		formatString: #,0
		lineageTag: d0597778-13b1-4291-8358-070808995225
		summarizeBy: sum
		sourceColumn: Sales

	column 'Prior Year Amount'
		dataType: int64
		formatString: #,0
		lineageTag: dd0569d7-1ca6-4cae-8e9a-8ea76ee57a02
		summarizeBy: sum
		sourceColumn: Prior Year Amount

	column 'YoY Delta'
		dataType: int64
		formatString: #,0
		lineageTag: e5f7d5d2-555e-48c4-826b-bedee73468a4
		summarizeBy: sum
		sourceColumn: YoY Delta

	column 'Sales Amount'
		dataType: int64
		formatString: #,0
		lineageTag: ce89b43f-c8e2-4198-bacb-ea443fd8248a
		summarizeBy: sum
		sourceColumn: Sales Amount

	column Segment
		dataType: string
		lineageTag: 538b962e-0bca-4470-829c-24ff73c3fecc
		summarizeBy: none
		sourceColumn: Segment

		annotation SummarizationSetBy = Automatic

	column 'Monthly Change'
		dataType: int64
		formatString: 0
		lineageTag: 7bf4ac7b-f1eb-4d42-9ebe-64d916078456
		summarizeBy: sum
		sourceColumn: Monthly Change

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		dataType: int64
		formatString: 0
		lineageTag: 4aa2a966-9724-481e-bbaa-0ef2f6d4aba7
		summarizeBy: sum
		sourceColumn: MonthNumber

		annotation SummarizationSetBy = Automatic

	column 'Month Start'
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 5715dbcd-a44b-4b6a-889c-d7f0bd594f25
		summarizeBy: none
		sourceColumn: MonthStart

		variation Variation
			isDefault
			relationship: 8d7e6cec-fc36-4a22-b7ee-2884c16003f5
			defaultHierarchy: LocalDateTable_c712f5ab-4779-439c-87d7-35d243771b65.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	partition RetailData = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/KhalidSaadaldinYahia/retail-pulse-dashboard/main/project/data/retail_sales_monthly.csv"), [Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(PromotedHeaders, {{"Category", type text}, {"Category Code", type text}, {"Year", Int64.Type}, {"Sales", Int64.Type}, {"Prior Year Amount", Int64.Type}, {"YoY Delta", Int64.Type}, {"Sales Amount", Int64.Type}, {"Segment", type text}, {"Monthly Change", Int64.Type}, {"MonthNumber", Int64.Type}, {"MonthStart", type date}})
				in
					Typed
